# ====== OBLIGATORII ======

# Token bot Discord
DISCORD_TOKEN=INSERISCI_TOKEN_BOT

# Serverul principal FiveM Legacy of CLT
MAIN_GUILD_ID=1505903653079351357

# Serverul Discord EMS / Medici
EMS_GUILD_ID=1518542545569976492

# Canal din serverul principal unde se folosesc /contract si /semneaza
CONTRACT_CHANNEL_ID=1548327664694333520

# Canal din serverul EMS unde se posteaza contractele generate
CONTRACT_LOG_CHANNEL_ID=1548329089956581487

# Roluri care pot emite contracte cu /contract (separate prin virgula)
RECRUITER_ROLE_IDS=1517181051288420372


# ====== DEMISII (opționale, dar necesare pentru sistemul de demisie) ======

# Canal din serverul EMS unde membrii scriu demisia
DEMISIE_CHANNEL_ID=INSERISCI_ID_CANALE_DEMISIE

# Canal log in serverul EMS
EMS_LOG_CHANNEL_ID=INSERISCI_ID_CANALE_LOG_EMS

# Canal log in serverul principal FiveM
MAIN_LOG_CHANNEL_ID=INSERISCI_ID_CANALE_LOG_MAIN

# Roluri staff care pot accepta/refuza demisii (separate prin virgula)
STAFF_ROLE_IDS=ID_RUOLO_1,ID_RUOLO_2,ID_RUOLO_3


# ====== DOCUMENTE MEDICALE (/radiografie, /analize) ======

# Canalele unde se pot folosi comenzile (pot fi pe servere diferite)
MEDICAL_CHANNEL_IDS=1553137969899114646,1539978574864326737

# Roluri care pot emite documente medicale. Gol = oricine scrie in canalele de mai sus.
MEDICAL_ROLE_IDS=


# ====== OPȚIONALE ======

# Canalul folosit pentru generarea invitatiei in serverul EMS.
# Gol = botul alege automat primul canal unde are permisiunea de invitatie.
EMS_INVITE_CHANNEL_ID=

# Invitatie: durata in secunde (0 = nu expira) si numar de folosiri (0 = nelimitat)
INVITE_MAX_AGE=604800
INVITE_MAX_USES=1

# Logo-uri pentru documente. Gol = se foloseste assets/logos/ sau iconita serverului.
MAIN_LOGO_URL=
EMS_LOGO_URL=

# Identitate afisata pe documente
CITY_NAME=Legacy of CLT
DEPARTMENT_NAME=Legacy EMS
DEPARTMENT_SUBTITLE=Departamentul Medical

# Rezerva pentru contractele vechi, fara grad salvat. Gradul normal se scrie
# in comanda /contract (grad_angajat), nu aici.
DEFAULT_FUNCTION=Paramedic Stagiar

BOT_PREFIX=!
DB_PATH=/data/legacy_ems.db
TIMEZONE=Europe/Bucharest
DELETE_TRIGGER_MESSAGE=false
